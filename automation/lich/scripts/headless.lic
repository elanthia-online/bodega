
Script.start("log")

fput("go table")

# Get scan type from environment variable or auto-detect from time
scan_type = ENV['BODEGA_SCAN_TYPE'] || (Time.now.hour == 8 ? 'full' : 'smart')

if scan_type == 'full'
  Lich.log("Starting Full Bodega Scan (scan type: #{scan_type})")
  Script.run("bodega", "--parser --smart --save")
  Script.run("bodega", "--parser --save")
else
  Lich.log("Starting Smart Bodega Scan (scan type: #{scan_type})")
  Script.run("bodega", "--parser --smart --save")
end

Lich.log("Bodega out -- quitting!")

fput("quit")