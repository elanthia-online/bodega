#!/bin/bash
set -e

echo "=== Bodega Consolidated - Automation Scan ==="

# Setup logging
LOG_FILE="automation/logs/scan-$(date +%Y%m%d-%H%M%S).log"
mkdir -p automation/logs

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Cleanup function
cleanup() {
    log "Cleaning up processes..."
    pkill -f lich || true
    pkill -f ruby || true
}
trap cleanup EXIT

# Record why the scan failed as step outputs (failure_reason: a short code;
# failure_message: one line for people), so later jobs such as a failure
# alert can say why without parsing logs. Step outputs are kept even when
# the step fails. A job timeout kills this script, so it sets nothing; the
# job result ('cancelled') covers that case.
#   setup_error              Lich or its auth file is missing
#   game_server_unreachable  Lich never logged in: game server down
#   lich_startup_failed      Lich died during startup for another reason
#   lich_failed              Lich exited nonzero during the scan
set_failure() {
    [ -n "$GITHUB_OUTPUT" ] || return 0
    {
        echo "failure_reason=$1"
        echo "failure_message=$2"
    } >> "$GITHUB_OUTPUT"
}

log "Starting bodega automation scan"
# Do not log SIMU_USERNAME - it is the account login name and lands in
# retained log artifacts.

# Determine scan type. The CI pipeline (pipeline.yml) passes an explicit
# 'full' or 'smart' after gating on the once-per-UTC-day marker in the
# restored state.json, so it never reaches the 'auto' branch below. The
# 'auto' fallback is only for manual local invocation without an argument,
# and defaults to a smart scan (a full scan can always be forced with
# 'run-scan full').
SCAN_TYPE="${1:-auto}"
if [ "$SCAN_TYPE" = "auto" ]; then
    SCAN_TYPE="smart"
    log "Scan type: SMART (auto default - pass 'full' to force a full scan)"
else
    log "Scan type: ${SCAN_TYPE^^} (specified)"
fi

# Export for use by headless script
export BODEGA_SCAN_TYPE="$SCAN_TYPE"

# Validate setup
LICH_DIR="automation/lich"
if [ ! -f "$LICH_DIR/lich.rbw" ]; then
    log "ERROR: Lich not found at $LICH_DIR/lich.rbw"
    set_failure setup_error "Lich not found at $LICH_DIR/lich.rbw"
    exit 1
fi

if [ ! -f "$LICH_DIR/data/entry.dat" ]; then
    log "ERROR: Authentication file not found - run setup-environment first"
    set_failure setup_error "Authentication file not found - run setup-environment first"
    exit 1
fi

# Start Lich with our enhanced headless script
log "Launching Lich with enhanced Ruby automation..."
log "Command: ruby $LICH_DIR/lich.rbw --login $SIMU_CHARACTER --without-frontend --detachable-client=8000 --start-scripts=headless"

# Change to project root so relative paths work
cd "$(dirname "$0")/../.."

# Lich writes its own debug log (where connection errors land) to
# $LICH_DIR/temp/debug-*.log, not to stdout. Find this run's file.
lich_debug_log() {
    ls -t "$LICH_DIR"/temp/debug-*.log 2>/dev/null | head -1
}

# Explain a Lich failure in the Actions log. A refused/unreachable game
# server means the game is down (crashes and maintenance can last hours), so
# say so plainly and leave the retry to the next scheduled run instead of
# looking like a pipeline bug. Returns 0 if a game server outage was found.
# Pass "quiet" to skip dumping the debug log when no outage is found (used
# after a clean exit, where there is nothing to diagnose).
report_lich_failure() {
    local mode="${1:-}"
    local debug_log
    debug_log="$(lich_debug_log)"

    # Only an outage if Lich never got in: a run that logged in and later
    # hit a reset mid-scan is not a game server outage.
    if [ -n "$debug_log" ] && grep -qE "connecting to game server" "$debug_log" \
        && ! grep -qE "info: logged in as" "$debug_log" \
        && grep -qE "Errno::(ECONNREFUSED|ECONNRESET|ETIMEDOUT|EHOSTUNREACH|ENETUNREACH)|SocketError|getaddrinfo|timed out connecting to" "$debug_log"; then
        local detail
        detail="$(grep -m1 -oE "Errno::[A-Z]+|SocketError|getaddrinfo[^)]*|timed out connecting to [^ ]+" "$debug_log")"
        local server
        server="$(grep -m1 -oE "connecting to game server \([^)]*\)" "$debug_log" | sed -E 's/.*\((.*)\)/\1/')"
        local msg="Could not connect to the GemStone IV game server (${server:-unknown}): ${detail}. The game is most likely down (crash or maintenance). Nothing was scanned and the live site is unchanged; the next scheduled run will try again."
        log "ERROR: $msg"
        set_failure game_server_unreachable "Game server unreachable (${server:-unknown}: ${detail}); the game is likely down. The next scheduled run will try again."
        if [ -n "$GITHUB_ACTIONS" ]; then
            echo "::error title=Game server unreachable::$msg"
            if [ -n "$GITHUB_STEP_SUMMARY" ]; then
                {
                    echo "### Game server unreachable"
                    echo
                    echo "$msg"
                } >> "$GITHUB_STEP_SUMMARY"
            fi
        fi
        return 0
    fi

    [ "$mode" = "quiet" ] && return 1

    if [ -n "$debug_log" ]; then
        log "Last 30 lines of Lich debug log ($debug_log):"
        tail -30 "$debug_log"
    else
        log "No Lich debug log found under $LICH_DIR/temp"
    fi
    return 1
}

# Launch Lich
ruby "$LICH_DIR/lich.rbw" \
  --login "$SIMU_CHARACTER" \
  --without-frontend \
  --detachable-client=8000 \
  --start-scripts=headless \
  >> "$LOG_FILE" 2>&1 &

LICH_PID=$!
log "Lich started with PID: $LICH_PID"

# Wait for Lich to initialize
log "Waiting for Lich to authenticate..."
sleep 10

# Check if Lich is still running
if ! kill -0 $LICH_PID 2>/dev/null; then
    log "ERROR: Lich process died during startup"
    if ! report_lich_failure; then
        log "Last 30 lines of log:"
        tail -30 "$LOG_FILE" 2>/dev/null || log "Could not read log file"
        if [ -n "$GITHUB_ACTIONS" ]; then
            echo "::error title=Lich died during startup::Lich exited within 10s of launch. See the Lich debug log above and the scrape-logs artifact."
        fi
        set_failure lich_startup_failed "Lich exited within 10s of launch; see the scrape-logs artifact."
    fi
    exit 1
fi

# Wait for Lich to complete. Disable errexit around the wait so a nonzero
# Lich exit is captured and logged below rather than aborting the script.
log "Waiting for automation to complete..."
set +e
wait $LICH_PID
exit_code=$?
set -e

# Lich can also exit cleanly after a failed connect if it took longer than
# the startup check above (its own 30s connect timeout, retried once on the
# alternate host, then exit 0), so check for an outage on every exit.
report_mode=""
[ $exit_code -eq 0 ] && report_mode="quiet"
if report_lich_failure "$report_mode"; then
    [ $exit_code -eq 0 ] && exit_code=1
elif [ $exit_code -eq 0 ]; then
    log "Automation completed successfully"
else
    log "Automation failed with exit code: $exit_code"
    log "Check log file: $LOG_FILE"
    set_failure lich_failed "Lich exited with code $exit_code during the scan; see the scrape-logs artifact."
fi

log "Scan completed - exit code: $exit_code"
exit $exit_code